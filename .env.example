# ── Contact form delivery (Resend) ─────────────────────────────────────
# Without RESEND_API_KEY the form tells visitors to email directly instead
# of pretending to send. Sign up at https://resend.com, create an API key,
# and add it in Vercel → Settings → Environment Variables.
RESEND_API_KEY=
# Inbox that receives submissions.
CONTACT_EMAIL=wileni01@gmail.com
# Sender address. Resend's onboarding sender works without domain setup but
# only delivers to the Resend account owner's email. Verify nickwiley.ai in
# Resend to use something like "Nick Wiley <contact@nickwiley.ai>".
RESEND_FROM=Portfolio Contact <onboarding@resend.dev>

# Address shown publicly on the site (mailto: links). Defaults to the one in
# lib/site.ts when unset.
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Cloudflare Turnstile CAPTCHA (optional) ─────────────────────────────
# https://dash.cloudflare.com → Turnstile. Both keys required to enable;
# the form falls back to honeypot + rate limiting without them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Site URL ────────────────────────────────────────────────────────────
# Canonical origin with no trailing slash or whitespace.
NEXT_PUBLIC_SITE_URL=https://www.nickwiley.ai
